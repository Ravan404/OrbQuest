{
  "name": "orbquest",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Local timer for Discord's play-a-game Quests on Windows. Uses Discord's own list of detectable games; never logs into Discord.",
  "license": "MIT",
  "author": "Ravan404",
  "homepage": "https://github.com/Ravan404/OrbQuest#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ravan404/OrbQuest.git"
  },
  "bugs": {
    "url": "https://github.com/Ravan404/OrbQuest/issues"
  },
  "keywords": [
    "orbquest",
    "discord",
    "discord-quests",
    "quest",
    "timer",
    "windows",
    "desktop"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --external:vite --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "clean": "node -e \"for (const p of ['dist','node_modules/.vite']) require('fs').rmSync(p,{recursive:true,force:true})\"",
    "update-database": "tsx scripts/update-game-database.ts",
    "verify:dist": "node scripts/verify-dist.mjs",
    "bump-version": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "^1.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
